# mock = local fake firewall (no network). live = real BRANE endpoint.
BRANE_MODE=mock
BRANE_BASE_URL=https://brane.ai-z.io/api/v1
BRANE_API_KEY=
BRANE_MODEL=auto
# Set to 1 to simulate BRANE being unreachable (check-failure test)
BRANE_SIMULATE_DOWN=0
# Live API shape (defaults = OpenAI-compatible). Adapt once AI-Z confirms BRANE's API.
BRANE_CHAT_PATH=/chat/completions
BRANE_AUTH_HEADER=Authorization
BRANE_AUTH_SCHEME=Bearer
# Extra headers as JSON, e.g. {"X-Tenant": "404-legends"}
BRANE_EXTRA_HEADERS=
# Team / policy version written into the evidence CSV
TEAM_BUILD=Team-13 / policy-v1
# full = mask locally before BRANE; guard_only = let BRANE pseudonymise names/contacts/health
LOCAL_PREMASK=full
